# ---------------------------------------------------------------------------
# LLM API Settings
# ---------------------------------------------------------------------------

# External LLM API Key (e.g., Anthropic Claude / OpenAI GPT)
# Used by LLMAPIClient in src/dv_agentic/tools/llm/api.py
LLM_API_KEY=your_external_api_key_here

# ---------------------------------------------------------------------------
# Local LLM Settings (Phase 2)
# ---------------------------------------------------------------------------

# Base URL for the local OpenAI-compatible LLM service
# Used by LocalLLMClient in src/dv_agentic/tools/llm/local.py
LOCAL_LLM_BASE_URL=http://localhost:8080

# API Key for the local LLM service (if required)
# Used by LocalLLMClient in src/dv_agentic/tools/llm/local.py
LOCAL_LLM_API_KEY=your_local_api_key_here
